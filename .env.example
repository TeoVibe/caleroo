# Copy to .env. Docker Compose reads this file automatically.
# Leave BASE_URL empty to use OpenRouter: https://openrouter.ai/api/v1
# Create an openrouter key at https://openrouter.ai/workspaces/default/keys
BASE_URL=https://openrouter.ai/api/v1
API_KEY=
# Empty MODEL on OpenRouter uses google/gemini-2.5-flash.
# Your own server needs a vision model name here, or one typed in the app.
MODEL=google/gemini-2.5-flash
APP_URL=http://localhost:6969
# false keeps one shared log and does not ask anyone to log in.
# true gives each person their own log. They register with a password, goals, and an avatar.
AUTHENTICATION=false
