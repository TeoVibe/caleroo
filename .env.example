# Copy to .env. Docker Compose reads this file automatically.
# INFERENCE is openrouter or local.
INFERENCE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Used when INFERENCE=local. Point this at an OpenAI-compatible /v1 base.
# A server on this machine is http://host.docker.internal:8000/v1 from Docker.
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=
APP_URL=http://localhost:6969
